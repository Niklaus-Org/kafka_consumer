  @Service
  @Slf4j
  public class VideoEventProducer {
    @Autowired
    private KafkaTemplate<String, VideoEventDTO> kafkaTemplate;

    public void publishEvent(VideoEventDTO event) {
      String key = event.getVideoId().toString();
      kafkaTemplate.send("video-events", key, event)
        .addCallback(
          result -> log.info("Published event: {}", event.getEventType()),
          ex -> log.error("Failed to publish event", ex)
        );
    }

    public void publishEventSync(VideoEventDTO event) throws Exception {
      String key = event.getVideoId().toString();
      kafkaTemplate.send("video-events", key, event).get();
    }
  }
