  import React, { useState, useRef } from 'react';
  import { publishEvent } from '../services/api';

  export default function VideoPlayer({ videoId, userId }) {
    const videoRef = useRef(null);
    const [isPlaying, setIsPlaying] = useState(false);

    const sendEvent = (eventType) => {
      publishEvent({
        videoId: videoId,
        userId: userId,
        eventType: eventType,
        watchedSeconds: videoRef.current?.currentTime || 0,
        qualityLevel: '1080p'
      }).catch(err => console.error('Error publishing event:', err));
    };

    const handlePlay = () => {
      setIsPlaying(true);
      sendEvent('PLAY');
    };

    const handlePause = () => {
      setIsPlaying(false);
      sendEvent('PAUSE');
    };

    const handleSeek = () => sendEvent('SEEK');
    const handleEnded = () => sendEvent('ENDED');

    return (
      <div>
        <video
          ref={videoRef}
          width="100%"
          controls
          onPlay={handlePlay}
          onPause={handlePause}
          onSeeked={handleSeek}
          onEnded={handleEnded}
        >
          <source src="https://www.w3schools.com/html/mov_bbb.mp4" type="video/mp4" />
        </video>
      </div>
    );
  }
  ```

