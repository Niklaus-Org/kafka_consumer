  ```java
  @RestController
  @RequestMapping("/api/analytics")
  @Slf4j
  public class AnalyticsController {
    @Autowired
    private VideoAnalyticsRepository analyticsRepository;

    @GetMapping("/{videoId}")
    public ResponseEntity<VideoAnalyticsDTO> getVideoAnalytics(@PathVariable UUID videoId) {
      return analyticsRepository.findById(videoId)
        .map(this::convertToDTO)
        .map(ResponseEntity::ok)
        .orElse(ResponseEntity.notFound().build());
    }

    @GetMapping("/dashboard")
    public ResponseEntity<Map<String, Object>> getDashboard() {
      List<VideoAnalytics> topVideos = analyticsRepository.findTop10ByOrderByTotalViewsDesc();
      Long totalViews = topVideos.stream().mapToLong(VideoAnalytics::getTotalViews).sum();
      
      Map<String, Object> dashboard = new HashMap<>();
      dashboard.put("totalViews", totalViews);
      dashboard.put("topVideos", topVideos);
      dashboard.put("videoCount", topVideos.size());
      
      return ResponseEntity.ok(dashboard);
    }

    private VideoAnalyticsDTO convertToDTO(VideoAnalytics analytics) {
      VideoAnalyticsDTO dto = new VideoAnalyticsDTO();
      dto.setVideoId(analytics.getVideoId());
      dto.setTotalViews(analytics.getTotalViews());
      if (analytics.getPlayCount() > 0) {
        dto.setAvgWatchTimeSeconds((double) analytics.getTotalPlaytimeSeconds() / analytics.getPlayCount());
      }
      if (analytics.getPauseCount() > 0) {
        dto.setPlayPauseRatio((double) analytics.getPlayCount() / analytics.getPauseCount());
      }
      return dto;
    }
  }
  ```
